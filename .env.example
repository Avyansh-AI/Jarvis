# ---------- Core ----------
# Passphrase used to encrypt memory/settings at rest (AES-256-GCM).
# If unset, a random local key is generated at data/.master.key (chmod 600).
# MAX_SECRET=change-me

# Optional bearer token required from UI/satellite clients (set for multi-user homes)
# MAX_TOKEN=

# Port the hub listens on (binds 0.0.0.0)
PORT=8080

# ---------- LLM brain — Jarvis Multi-Agent Map ----------
# Architecture (see uploads/jarvis_mind_map.png):
#   Jarvis (Multi-agent assistant)
#     ├─ Host      → gpt-oss-120b  (OpenRouter, 3-key rotation)
#     ├─ Sub-agents → Qwen3.6-27b  (5 accounts, parallel workers)
#     ├─ TTS       → Orpheus       (Groq TTS)
#     └─ Fallback  → Gemini        (3-key overflow)
#
# Cloud via OpenRouter — used when settings.privacy.llm === 'cloud'
# Get keys at https://openrouter.ai/keys
# REQUIRED (v1.0.7): exactly these three rotation slots, one key each.
# .env is the ONLY place keys live — no Settings-UI storage, no legacy aliases
# (a one-time boot migration folds any older formats into these and comments
# out the old lines). Boot FAILS fast naming any missing slot.
OPENROUTER_KEY_1=your_openrouter_key_1_here
OPENROUTER_KEY_2=your_openrouter_key_2_here
OPENROUTER_KEY_3=your_openrouter_key_3_here
# Explicit CI/test-only override that lets the hub boot without keys
# (prints loudly; never set this on a real install):
# JARVIS_ALLOW_KEYLESS=1
# Host model — primary brain (gpt-oss-120b via OpenRouter)
# HOST_MODEL=openai/gpt-oss-120b
# Any OpenRouter model id, e.g. anthropic/claude-sonnet-4-5, openai/gpt-4o-mini, meta-llama/...
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Sub-agents — Qwen3.6-27b with 5 accounts (parallel workers)
# If QWEN_KEY_1..5 are set, each sub-agent gets its own account; otherwise they
# overflow to OPENROUTER_KEY_1..3 so the system still works zero-config.
# QWEN_KEY_1=your_qwen_account_1_key
# QWEN_KEY_2=your_qwen_account_2_key
# QWEN_KEY_3=your_qwen_account_3_key
# QWEN_KEY_4=your_qwen_account_4_key
# QWEN_KEY_5=your_qwen_account_5_key
# QWEN_MODEL=qwen/qwen3-27b

# Fallback — Gemini with 3-key overflow (safety net)
# If GEMINI_KEY_1..3 are set, fallback uses them; otherwise overflows to OPENROUTER keys.
# GEMINI_KEY_1=your_gemini_key_1
# GEMINI_KEY_2=your_gemini_key_2
# GEMINI_KEY_3=your_gemini_key_3
# FALLBACK_MODEL=google/gemini-2.0-flash-001
# GEMINI_MODEL=google/gemini-2.0-flash-001

# TTS — Orpheus via Groq (ultra-low-latency voice)
# Get key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key_here
# GROQ_TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
# GROQ_TTS_VOICE=tara
# TTS_MODEL=orpheus
# TTS_VOICE=tara
# GROQ_TTS_URL=https://api.groq.com/openai/v1/audio/speech

# Model ladder (best → worst capability), used for automatic best-model
# selection with CONFIRM-BEFORE-DEGRADE: anything OpenRouter-accessible,
# including Gemini ids (there is no separate Gemini provider — gemini-*
# models are reached through OpenRouter with the same keys/rotation).
# Entries prefixed ollama: are the local rung. Unset = [OPENROUTER_MODEL or
# settings model, then Ollama]. Switching to a LOWER cloud rung always asks
# first (once per outage); 3-key rotation inside a rung stays automatic;
# total cloud outage falls back to the local model with a plain announcement.
# Default ladder now follows the multi-agent map:
#   openai/gpt-oss-120b, qwen/qwen3-27b, google/gemini-2.0-flash-001, ollama:...
# MODEL_PRIORITY=openai/gpt-oss-120b, qwen/qwen3-27b, google/gemini-2.0-flash-001, ollama:llama3.1
# Optional ranking metadata shown on openrouter.ai
# OPENROUTER_REFERER=http://localhost:8080
# OPENROUTER_TITLE=Jarvis
# OPENROUTER_BASE=https://openrouter.ai/api/v1   (override to point at any OpenAI-compatible endpoint)

# Local fallback (Ollama) — used when offline, when llm==='local', or when cloud fails
# OLLAMA_URL=http://127.0.0.1:11434
# Default local model (pull it once):
#   ollama pull hf.co/huihui-ai/Huihui-Qwythos-9B-Claude-Mythos-5-1M-abliterated-GGUF:Q4_K_M
# OLLAMA_MODEL=hf.co/huihui-ai/Huihui-Qwythos-9B-Claude-Mythos-5-1M-abliterated-GGUF

# ---------- Smart home (Home Assistant) ----------
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=long-lived-access-token

# ---------- Misc integrations (optional) ----------
# LIBRETRANSLATE_URL=https://libretranslate.com
# NEWS_FEED=https://feeds.bbci.co.uk/news/rss.xml
# EMERGENCY_WEBHOOK=   (e.g. Twilio/IFTTT/Zapier hook called on SOS)
# SPOTIFY_HOOK=        (generic webhook for media control)
# TESLA_TOKEN= / SMARTCAR_TOKEN=   (vehicle providers; 'demo' works with none)

# ---------- Updates ----------
# ALLOW_SELF_UPDATE=1   (enables POST /api/system/update, runs scripts/update.sh)
