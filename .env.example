# ---------- Core ----------
# Passphrase used to encrypt memory/settings at rest (AES-256-GCM).
# If unset, a random local key is generated at data/.master.key (chmod 600).
# MAX_SECRET=change-me

# Optional bearer token required from UI/satellite clients (set for multi-user homes)
# MAX_TOKEN=

# Port the hub listens on (binds 0.0.0.0)
PORT=8080

# ---------- LLM brains (v1.1.0 multi-brain) ----------
# Three SANCTIONED providers, one policy for all of them: keys live ONLY in
# .env as numbered slots — never in Settings, never via legacy aliases (a
# one-time boot migration folds older formats into these and comments out the
# old lines), never echoed anywhere; every surface shows counts only.
#
# Host brain — OpenRouter rotation (https://openrouter.ai/keys). Slots 1..3
# are the canonical ring; _4.._16 also load, gap-tolerant.
# Boot gate (v1.1.0): refuses to start ONLY when NO provider has any key at
# all; a partial OpenRouter ring boots with a loud warning naming the empty
# slots, because the overflow brains below can carry the fallback model.
# OPENROUTER_KEY_1=
# OPENROUTER_KEY_2=
# OPENROUTER_KEY_3=
#
# Sub-agents + server voice — Groq (console.groq.com/keys). The Host delegates
# narrow mechanical tasks to a silent executor here, and /api/tts synthesizes
# replies on it. Same numbered-slot discipline: GROQ_KEY_1..n.
# GROQ_KEY_1=
# GROQ_KEY_2=
# GROQ_KEY_3=
#
# Overflow brain — Google AI Studio (aistudio.google.com/apikey). Feeds the
# gemini: rungs of the ladder (fallback capacity); same slots: GEMINI_KEY_1..n.
# GEMINI_KEY_1=
# GEMINI_KEY_2=
# GEMINI_KEY_3=
#
# Explicit CI/test-only override that lets the hub boot without ANY keys
# (prints loudly; never set this on a real install):
# JARVIS_ALLOW_KEYLESS=1
# Any OpenRouter model id, e.g. anthropic/claude-sonnet-4-5, openai/gpt-4o-mini, meta-llama/...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# Model ladder (best → worst capability), used for automatic best-model
# selection with CONFIRM-BEFORE-DEGRADE. Entries are OpenRouter model ids by
# default (anything OpenRouter-accessible, including gemini-* ids reached with
# the same keys/rotation). Provider PREFIXES route a rung through that
# provider's OWN .env keys (v1.1.0): `groq:llama-3.3-70b-versatile`,
# `gemini:gemini-3.1-flash`; `ollama:` is the local floor (auto-appended).
# A rung whose provider has no keys is simply unusable — the ladder walks on.
# Unset = [OPENROUTER_MODEL or settings model, then Ollama]. Switching to a
# LOWER cloud rung (any provider) always asks first, once per outage; key
# rotation inside a rung stays automatic; total cloud outage falls back to the
# local model with a plain announcement. The user is never told WHO carries the
# conversation — the Host persona is preserved verbatim on every rung.
# MODEL_PRIORITY=openai/gpt-oss-120b, gemini:gemini-3.1-flash, groq:qwen-3-next-80b, ollama:llama3.1
# Optional ranking metadata shown on openrouter.ai
# OPENROUTER_REFERER=http://localhost:8080
# OPENROUTER_TITLE=Jarvis
# BASE overrides — only needed to point a provider at a proxy or a test hook
# (same OpenAI-compatible /chat/completions shape on all three):
# OPENROUTER_BASE=https://openrouter.ai/api/v1
# GROQ_BASE=https://api.groq.com/openai/v1
# GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# ---------- Sub-agents (delegate skill) ----------
# Model id on Groq the silent staff runs (a fast, cheap instruction-follower;
# verify the exact id on your Groq account — ids move).
# SUBAGENT_MODEL=qwen3-8-27b

# ---------- Server voice (TTS) ----------
# When TTS_MODEL is set (and Groq keys exist), POST /api/tts renders speech on
# the hub — pick a dry, composed voice to match the butler persona (unset =
# browser voices only; the client falls back automatically on any failure).
# TTS_MODEL=
# TTS_VOICE=
# TTS_PROVIDER=groq          (the only sanctioned base today; TTS_BASE overrides it)
# TTS_BASE=https://api.groq.com/openai/v1

# Local fallback (Ollama) — used when offline, when llm==='local', or when cloud fails
# OLLAMA_URL=http://127.0.0.1:11434
# Default local model (pull it once):
#   ollama pull hf.co/huihui-ai/Huihui-Qwythos-9B-Claude-Mythos-5-1M-abliterated-GGUF:Q4_K_M
# OLLAMA_MODEL=hf.co/huihui-ai/Huihui-Qwythos-9B-Claude-Mythos-5-1M-abliterated-GGUF

# ---------- Smart home (Home Assistant) ----------
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=long-lived-access-token

# ---------- Misc integrations (optional) ----------
# LIBRETRANSLATE_URL=https://libretranslate.com
# NEWS_FEED=https://feeds.bbci.co.uk/news/rss.xml
# EMERGENCY_WEBHOOK=   (e.g. Twilio/IFTTT/Zapier hook called on SOS)
# SPOTIFY_HOOK=        (generic webhook for media control)
# TESLA_TOKEN= / SMARTCAR_TOKEN=   (vehicle providers; 'demo' works with none)

# ---------- Local file creation (create skill) ----------
# Where generated PDFs/docs/decks/sites land (default: files/ next to the repo root).
# MAX_FILES_ROOT=/srv/jarvis/files
# Force the python interpreter used for real .docx/.pptx generation. Default is
# auto-detect (python3 → python → py -3, each validated by running it — the
# Windows Store alias stub can't hijack generation). Test/dev hook, same spirit
# as MAX_NET_PROBE_URL; leave unset on real installs.
# MAX_PY_CREATE=/usr/bin/python3

# ---------- Updates ----------
# ALLOW_SELF_UPDATE=1   (enables POST /api/system/update, runs scripts/update.sh)
